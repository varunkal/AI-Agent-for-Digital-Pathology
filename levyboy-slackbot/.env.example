# Copy to .env and fill in. Do NOT commit the real .env.

# --- Slack (from api.slack.com/apps, with Socket Mode enabled) ---
# SLACK_BOT_TOKEN - "Bot User OAuth Token", starts with xoxb-
# SLACK_APP_TOKEN - App-Level Token with connections:write, starts with xapp-
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# --- Agent backend ---
# stub = canned replies, runs anywhere, nothing to install (default)
# rag  = the real agent: local Qwen via Ollama, tools over the lab corpus
LEVYBOY_BACKEND=stub

# For BACKEND=rag, both of these are required.
#
# PYTHONPATH must include the pathology-agent rag/ directory (lab_agent lives
# there) and the lab_rag repo's rag/ directory (the ChromaDB config lives there):
#   export PYTHONPATH=~/pathology-agent/rag:~/labagent/rag
#
# LEVYBOY_CORPUS is the lab files the agent may read. It is also the read
# allowlist: the agent cannot open anything outside it.
LEVYBOY_CORPUS=~/pathology-agent/demo/corpus

# The model. Changing this one line is what moves the bot to Discovery:
# qwen3:4b (laptop) -> qwen3-coder (V100 node).
LAB_CHAT_MODEL=qwen3:4b

# Lab conventions injected into prompts (pitch deck Aim 2). Optional.
LAB_PROFILE_PATH=~/pathology-agent/demo/DEMO_LAB_PROFILE.md

# How long to wait for the agent before giving up and saying so. A measured run
# using trace_pipeline took 169s on an M3 laptop, so the 120s default can abandon
# runs that were working fine. On a GPU node this can come back down.
LEVYBOY_AGENT_TIMEOUT=300

# Model residency. 2 is correct: both the chat and embedding models stay
# resident. 1 forces an unload/reload on every agent step and Ollama drops
# connections mid-request under the churn.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
